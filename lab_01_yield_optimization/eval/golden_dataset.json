{
  "dataset_name": "vibetube_bidding_golden_benchmark",
  "version": "1.0.0",
  "description": "Evaluation benchmark for Vibetube compute_bid(context: AuctionContext) -> float",
  "test_cases": [
    {
      "id": "TC-01-MORNING-BASELINE",
      "category": "diurnal_regime",
      "description": "Steady morning audience buildup with moderate competition.",
      "input_context": {
        "daypart": "morning",
        "budget_remaining": 2200.0,
        "hours_remaining": 18.0,
        "max_bid_ceiling": 10.0,
        "win_rate": 0.88,
        "p90": 2.45,
        "p90_history": [2.30, 2.35, 2.40, 2.45],
        "win_rate_history": [0.90, 0.89, 0.88, 0.88]
      },
      "expected_bid_range": { "min": 2.40, "max": 2.70 },
      "rationale": "Clear morning floor (~$2.45 P90) to win auctions steadily while pacing budget."
    },
    {
      "id": "TC-02-LUNCH-SPIKE",
      "category": "diurnal_regime",
      "description": "Midday lunchtime traffic surge with elevated clearing prices.",
      "input_context": {
        "daypart": "lunch",
        "budget_remaining": 1800.0,
        "hours_remaining": 12.0,
        "max_bid_ceiling": 10.0,
        "win_rate": 0.45,
        "p90": 4.30,
        "p90_history": [3.20, 3.60, 4.00, 4.30],
        "win_rate_history": [0.60, 0.55, 0.50, 0.45]
      },
      "expected_bid_range": { "min": 4.25, "max": 4.80 },
      "rationale": "Compete aggressively during lunch peak by matching/exceeding ~$4.30 P90."
    },
    {
      "id": "TC-03-AFTERNOON-WAR-RAMP",
      "category": "momentum_velocity",
      "description": "Escalating afternoon bidding war where rivals rapidly drive prices upward.",
      "input_context": {
        "daypart": "afternoon",
        "budget_remaining": 1300.0,
        "hours_remaining": 8.0,
        "max_bid_ceiling": 10.0,
        "win_rate": 0.20,
        "p90": 8.50,
        "p90_history": [4.00, 5.50, 7.00, 8.50],
        "win_rate_history": [0.50, 0.40, 0.30, 0.20]
      },
      "expected_bid_range": { "min": 8.50, "max": 9.80 },
      "rationale": "Strong positive velocity (> 1.5) requires front-running competitors."
    },
    {
      "id": "TC-04-AFTERNOON-POST-WAR-CRASH",
      "category": "momentum_velocity",
      "description": "Flash collapse following a bidding war when competitors exhaust budgets.",
      "input_context": {
        "daypart": "afternoon",
        "budget_remaining": 1100.0,
        "hours_remaining": 7.0,
        "max_bid_ceiling": 10.0,
        "win_rate": 0.90,
        "p90": 1.80,
        "p90_history": [8.50, 6.00, 3.50, 1.80],
        "win_rate_history": [0.30, 0.50, 0.70, 0.90]
      },
      "expected_bid_range": { "min": 0.80, "max": 2.00 },
      "rationale": "Strong negative velocity (< -1.5) requires immediate bid shading down."
    },
    {
      "id": "TC-05-PRIMETIME-PEAK",
      "category": "diurnal_regime",
      "description": "Peak evening viewership with highest commercial value.",
      "input_context": {
        "daypart": "primetime",
        "budget_remaining": 700.0,
        "hours_remaining": 4.0,
        "max_bid_ceiling": 10.0,
        "win_rate": 0.30,
        "p90": 9.60,
        "p90_history": [8.80, 9.20, 9.50, 9.60],
        "win_rate_history": [0.40, 0.35, 0.32, 0.30]
      },
      "expected_bid_range": { "min": 9.60, "max": 10.00 },
      "rationale": "Clear primetime clearing floor ~$9.60-$9.80 up to authorized $10.00 ceiling."
    },
    {
      "id": "TC-06-LATE-NIGHT-DROPOUT",
      "category": "bid_shading",
      "description": "Late night hours where competitors drop out and clearing floor plummets.",
      "input_context": {
        "daypart": "late_night",
        "budget_remaining": 200.0,
        "hours_remaining": 2.0,
        "max_bid_ceiling": 10.0,
        "win_rate": 0.99,
        "p90": 0.90,
        "p90_history": [3.50, 1.80, 1.10, 0.90],
        "win_rate_history": [0.95, 0.98, 0.99, 0.99]
      },
      "expected_bid_range": { "min": 0.50, "max": 1.10 },
      "rationale": "Shade bid down to ~$0.90 to win 100% of impressions for pennies."
    },
    {
      "id": "TC-07-BUDGET-EXHAUSTION-RISK",
      "category": "budget_pacing",
      "description": "Campaign has low budget remaining relative to remaining flight hours.",
      "input_context": {
        "daypart": "afternoon",
        "budget_remaining": 150.0,
        "hours_remaining": 10.0,
        "max_bid_ceiling": 10.0,
        "win_rate": 0.60,
        "p90": 3.50,
        "p90_history": [3.40, 3.45, 3.50, 3.50],
        "win_rate_history": [0.60, 0.60, 0.60, 0.60]
      },
      "expected_bid_range": { "min": 0.50, "max": 3.30 },
      "rationale": "Pacing factor triggers conservative bid shading to conserve remaining funds."
    },
    {
      "id": "TC-08-UNDER-PACING-ACCELERATION",
      "category": "budget_pacing",
      "description": "Campaign is behind pace with abundant budget late in the flight.",
      "input_context": {
        "daypart": "primetime",
        "budget_remaining": 1800.0,
        "hours_remaining": 3.0,
        "max_bid_ceiling": 10.0,
        "win_rate": 0.50,
        "p90": 9.20,
        "p90_history": [9.00, 9.10, 9.15, 9.20],
        "win_rate_history": [0.50, 0.50, 0.50, 0.50]
      },
      "expected_bid_range": { "min": 9.50, "max": 10.00 },
      "rationale": "Accelerate bids up to the ceiling to ensure budget is fully delivered."
    },
    {
      "id": "TC-09-HARD-CEILING-CLAMP",
      "category": "safety_guardrail",
      "description": "Market P90 exceeds client authorized safety ceiling.",
      "input_context": {
        "daypart": "primetime",
        "budget_remaining": 900.0,
        "hours_remaining": 2.0,
        "max_bid_ceiling": 6.00,
        "win_rate": 0.10,
        "p90": 9.50,
        "p90_history": [8.00, 8.50, 9.00, 9.50],
        "win_rate_history": [0.20, 0.15, 0.12, 0.10]
      },
      "expected_bid_range": { "min": 5.50, "max": 6.00 },
      "rationale": "Must strictly clamp to client authorized ceiling of $6.00."
    },
    {
      "id": "TC-10-MINIMUM-FLOOR-CLAMP",
      "category": "safety_guardrail",
      "description": "Market crashes below platform minimum clearing threshold.",
      "input_context": {
        "daypart": "late_night",
        "budget_remaining": 100.0,
        "hours_remaining": 1.0,
        "max_bid_ceiling": 10.0,
        "win_rate": 0.99,
        "p90": 0.15,
        "p90_history": [0.80, 0.40, 0.20, 0.15],
        "win_rate_history": [0.99, 0.99, 0.99, 0.99]
      },
      "expected_bid_range": { "min": 0.50, "max": 0.60 },
      "rationale": "Must never bid below platform minimum clearing threshold of $0.50."
    }
  ]
}
